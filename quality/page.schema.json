{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bayanat-labs:arabic-document-atlas:page-schema:v1",
  "title": "Arabic Document Atlas normalized page v1",
  "description": "Shape validation only. validate.py also enforces canonical IDs, pixel bounds, membership, text joins, actual image bytes, confidence semantics and split audits.",
  "type": "object",
  "required": ["page_id", "logical_page_id", "source_collection", "source_document_id", "document_id", "work_group_id", "split", "image_request_profile", "image", "image_sha256", "width", "height", "source_url", "source_manifest_url", "source_manifest_sha256", "source_canvas_id", "source_page_label", "source_page_index", "source_image_url", "source_image_width", "source_image_height", "source_rights", "source_rights_url", "source_rights_basis", "page_text", "text_source", "annotation_review", "words", "lines", "mean_word_confidence", "arabic_char_fraction", "words_count", "page_status"],
  "properties": {
    "page_id": {"$ref": "#/$defs/sha256"},
    "logical_page_id": {"$ref": "#/$defs/sha256"},
    "source_collection": {"$ref": "#/$defs/nonempty"},
    "source_document_id": {"$ref": "#/$defs/nonempty"},
    "document_id": {"$ref": "#/$defs/nonempty"},
    "work_group_id": {"$ref": "#/$defs/nonempty"},
    "split": {"enum": ["train", "validation", "test"]},
    "image_request_profile": {"$ref": "#/$defs/nonempty"},
    "image": {"type": "object", "description": "HF Image binary bytes/path struct; bytes are binary in Arrow/Parquet, not a JSON string. Serialization adapters must preserve them.", "properties": {"path": {"type": ["string", "null"]}}, "additionalProperties": true},
    "image_sha256": {"$ref": "#/$defs/sha256"},
    "pixel_sha256": {"$ref": "#/$defs/sha256"},
    "dhash64": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "width": {"$ref": "#/$defs/dimension"},
    "height": {"$ref": "#/$defs/dimension"},
    "source_url": {"$ref": "#/$defs/https"},
    "source_manifest_url": {"$ref": "#/$defs/https"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_canvas_id": {"$ref": "#/$defs/nonempty"},
    "source_page_label": {"$ref": "#/$defs/nonempty"},
    "source_page_index": {"type": "integer", "minimum": 0},
    "source_image_url": {"$ref": "#/$defs/https"},
    "source_image_width": {"$ref": "#/$defs/dimension"},
    "source_image_height": {"$ref": "#/$defs/dimension"},
    "source_rights": {"$ref": "#/$defs/nonempty"},
    "source_rights_url": {"$ref": "#/$defs/https"},
    "source_rights_basis": {"$ref": "#/$defs/nonempty"},
    "page_text": {"type": "string"},
    "text_source": {"enum": ["tesseract", "apple_vision", "native_pdf", "source_proofread", "none"]},
    "annotation_review": {"enum": ["machine_generated", "source_community_proofread"]},
    "reference_text": {"type": ["string", "null"]},
    "proofread_status": {"type": ["integer", "string", "null"]},
    "words": {"type": "array", "items": {"$ref": "#/$defs/word"}},
    "lines": {"type": "array", "items": {"$ref": "#/$defs/line"}},
    "words_count": {"type": "integer", "minimum": 0},
    "mean_word_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "arabic_char_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "page_status": {"$ref": "#/$defs/nonempty"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dimension": {"type": "integer", "minimum": 1},
    "https": {"type": "string", "pattern": "^https://"},
    "id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer"}]},
    "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
    "word": {
      "type": "object", "required": ["id", "text", "bbox", "confidence", "line_id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/nonempty"}, "bbox": {"$ref": "#/$defs/bbox"}, "line_id": {"$ref": "#/$defs/id"}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "confidence_basis": {"type": "string"}}, "additionalProperties": true
    },
    "line": {
      "type": "object", "required": ["id", "text", "bbox", "word_ids", "order_index", "order_method"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"type": "string"}, "bbox": {"$ref": "#/$defs/bbox"}, "word_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "order_index": {"type": "integer", "minimum": 0}, "order_method": {"$ref": "#/$defs/nonempty"}, "bbox_method": {"type": "string"}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 100}}, "additionalProperties": true
    }
  },
  "additionalProperties": true
}
